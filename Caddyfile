# Caddy reverse proxy for the Jarvis Messenger webhook.
# Caddy auto-obtains + renews the Let's Encrypt cert (HTTP-01 on port 80) and
# terminates TLS, proxying plaintext to the `agent` container on the compose
# network. Certs/ACME account persist in the caddy_data volume (see
# docker-compose.yml) — never drop that volume or you re-issue and hit rate limits.
{
	email kuba.nowa888@gmail.com
}

ogarniacz.duckdns.org {
	# Public MCP tool servers (docs/MCP.md): /mcp/health, /mcp/<server>[/<key>].
	# No `log` directive on purpose — an access log would record keys sent in the URL.
	handle /mcp/* {
		reverse_proxy mcp:8010
	}
	handle {
		reverse_proxy agent:8002
	}
}
