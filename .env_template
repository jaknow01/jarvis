# ===========================================================================
# Models & providers (see CLAUDE.md → "Models / providers")
# ===========================================================================
# Each agent picks its model as a `provider/model` string; the provider is the
# part before the FIRST `/`. A BARE model (no `/`) means the `openai` provider,
# so old-style values keep working. Supported providers:
#   openai/…        → OpenAI Responses API (tools + reasoning together)
#   anthropic/…     → native Anthropic (extended thinking)
#   openrouter/…    → OpenAI-compatible (model id may itself contain a slash,
#                     e.g. openrouter/deepseek/deepseek-r1)
#   groq/… xai/…    → OpenAI-compatible
#   openai-compat/… → ad-hoc OpenAI-compatible escape hatch (set OPENAI_COMPAT_BASE_URL +
#                     OPENAI_COMPAT_API_KEY)
#   <server>/…      → a named server from config/providers.yaml (self-hosted vLLM/Ollama),
#                     e.g. gpu-server/RedHatAI/Qwen3.8-27B-INT4
#
# Provider API keys (only the ones you actually use are required):
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Key for self-hosted servers: a named server in config/providers.yaml reads the env var its
# `api_key_env` names (gpu-server → OPENAI_COMPAT_API_KEY; any string for open vLLM).
#   OPENAI_COMPAT_API_KEY=
# Ad-hoc `openai-compat/…` models only (no entry in config/providers.yaml):
#   OPENAI_COMPAT_BASE_URL=

# --- Models: named model profiles (config/models/<name>.yaml) ---
# Which model (+ reasoning effort, Anthropic thinking budget) every agent runs on is defined
# ONLY in model profile files — see config/models/prod.yaml and lib/core/model_profiles.py.
# Pick the active one by file name; defaults to `prod`. Changing it needs a restart.
# (Per-user/group model overrides from config/principals.yaml still win over the profile.)
# The old DEFAULT_MODEL / AGENT_<NAME>_MODEL / *_REASONING_EFFORT / *_THINKING_BUDGET /
# COORDINATOR_MODEL / OPENAI_DEFAULT_MODEL variables are no longer read.
MODEL_PROFILE=
# Optional: a different directory holding the profile files (default config/models).
#   MODEL_PROFILES_DIR=

# --- Conversation context window (rolling history + incremental compression) ---
# Instead of replaying the whole conversation each turn, keep the last N user/assistant
# pairs verbatim and fold everything older into a short running summary (updated
# incrementally as turns age out). See lib/runtime/history_window.py.
#   HISTORY_COMPRESSION_ENABLED   master switch; falsy (0/false/no/off) ⇒ full history
#                                 verbatim (legacy behaviour). Default on.
#   HISTORY_WINDOW_PAIRS          verbatim user/assistant pairs kept. Default 3.
#   HISTORY_SUMMARY_MAX_SENTENCES max sentences in the running summary. Default 5.
# The summariser model uses the same AGENT_<NAME>_… convention under the name
# "history_compressor" (falls back to DEFAULT_MODEL):
#   AGENT_HISTORY_COMPRESSOR_MODEL=            provider/model (bare → openai)
#   AGENT_HISTORY_COMPRESSOR_REASONING_EFFORT= off/minimal/low/medium/high
HISTORY_COMPRESSION_ENABLED=
HISTORY_WINDOW_PAIRS=
HISTORY_SUMMARY_MAX_SENTENCES=

GOOGLE_MAPS_API_KEY=
XAI_API_KEY=
OPENWEATHER_API_KEY=
TAVILY_API_KEY=

# Apple iCloud calendar (calendar_agent, CalDAV). Read/write access to your Apple
# calendar. Use an APP-SPECIFIC PASSWORD, not your main Apple ID password:
#   appleid.apple.com -> Sign-In and Security -> App-Specific Passwords -> generate one
#   (it can be revoked independently at any time). The app never sees your real password.
# The Apple ID e-mail and the app password are used only server-side (never sent to the
# LLM). Leave these empty to keep the calendar agent effectively disabled (its tools will
# return a clear "not configured" error).
ICLOUD_CALDAV_USER=
ICLOUD_APP_PASSWORD=
# Optional: CalDAV endpoint (default https://caldav.icloud.com/) and the calendar NEW
# events are written to (its display name; empty = the account's first calendar). If the
# named calendar does not exist yet, it is auto-created on iCloud on the first write.
ICLOUD_CALDAV_URL=
ICLOUD_CALENDAR_NAME=
# Optional: which calendars READS span (listing events, and finding one to edit/delete),
# as a comma-separated list of display names. Empty = ALL calendars on the account. Reads
# and writes are separate: you can write to just ICLOUD_CALENDAR_NAME (e.g. "Asystent")
# while still reading "Dom", "Praca", etc. The write calendar is always included in reads.
#   ICLOUD_READ_CALENDARS=Asystent,Dom,Praca
ICLOUD_READ_CALENDARS=

# Fantasy Premier League (unofficial, keyless API). Your own manager ("entry") id
# and the mini-league you care about, used by the fpl_agent for "my squad" / "my
# league". Find your entry id in the URL after logging in at fantasy.premierleague.com
# and opening "Points": fantasy.premierleague.com/entry/<ENTRY_ID>/event/<GW>.
# Find a league id by opening that league's page: .../leagues/<LEAGUE_ID>/standings/c
# (or leave FPL_LEAGUE_ID empty and ask the agent to list your leagues).
FPL_ENTRY_ID=
FPL_LEAGUE_ID=
# How long (seconds) the FPL reference data (players/teams) may be cached in Postgres
# before it is refreshed from the API. Optional; defaults to 21600 (6h). The data
# changes ~daily (prices/form/news), so a few hours is plenty.
FPL_CACHE_TTL_SECONDS=
# How long (seconds) a cached mini-league squad snapshot may be reused before a query
# triggers a fresh API scan. Optional; defaults to 10800 (3h). Picks are frozen once a
# gameweek's deadline passes, so stale reads mainly matter across a gameweek rollover.
FPL_LEAGUE_CACHE_TTL_SECONDS=
# Background warming of the owner's FPL_LEAGUE_ID squad cache so "who else has player X /
# how many own a player from team Y" answers come from Postgres, not a slow live scan.
# FPL_CACHE_REFRESH_ENABLED: master switch, on unless set falsy (0/false/no/off).
# FPL_CACHE_REFRESH_INTERVAL_SECONDS: how often to re-warm; optional, defaults to 10800 (3h).
# Only the configured league is warmed here (never national/global leagues); other private
# leagues are still cached lazily the first time you ask about them.
FPL_CACHE_REFRESH_ENABLED=
FPL_CACHE_REFRESH_INTERVAL_SECONDS=

# --- MCP tool servers (docs/MCP.md) ---
# Where fpl_agent's tools run: `local` (default, in-process) or `mcp` (the FPL MCP server).
# With `mcp`, Jarvis falls back to the local tools while the server is unreachable.
FPL_TOOLS_SOURCE=
# The FPL MCP endpoint and Jarvis's own API key for it (a client in config/mcp_clients.yaml
# whose fpl: entry_id/league_id are the owner's). In docker compose: http://mcp:8010/mcp/fpl
FPL_MCP_URL=
FPL_MCP_API_KEY=
# Server side (app/mcp_server.py): bind address, which servers to run (comma list, default
# all exposable = fpl), clients file, per-client calls/minute, per-call wall clock (s).
MCP_HOST=
MCP_PORT=
MCP_SERVERS=
MCP_CLIENTS_CONFIG=
MCP_RATE_LIMIT_PER_MINUTE=
MCP_TOOL_TIMEOUT_SECONDS=
# Self-service key page /mcp/join: on/off (default on), leagues whose managers may get a
# key (comma list; default FPL_LEAGUE_ID), public base URL shown in the instructions (else
# derived from proxy headers), attempts per IP per hour (10), league roster cache (600 s),
# how often the server re-reads issued keys (15 s = revocation delay).
MCP_JOIN_ENABLED=
MCP_JOIN_LEAGUE_IDS=
MCP_PUBLIC_URL=
MCP_JOIN_PER_HOUR=
MCP_JOIN_ROSTER_TTL_SECONDS=
MCP_KEYS_REFRESH_SECONDS=
# Client side: tool-listing cache TTL, retry delay after a failed listing, timeouts (s).
MCP_TOOLS_TTL_SECONDS=
MCP_RETRY_SECONDS=
MCP_LIST_TIMEOUT_SECONDS=
MCP_CALL_TIMEOUT_SECONDS=

# ===========================================================================
# Daily time-series collectors ("observations") — see docs/OBSERVATIONS.md
# ===========================================================================
# Two deterministic (no-LLM) collectors run in the long-running service and store one
# reading per metric per day so the assistant can analyze data OVER TIME, not just report
# the current snapshot. Finance (FX/index/metals) is collected at 23:00; a daily snapshot of
# the owner's FPL mini-league (every manager's rank, points and squad) at 04:00. Both write
# to the `observations` / `fpl_league_history` tables (needs DATABASE_URL; finance also has a
# JSON fallback). Backfill one year of finance history once with:
#   poetry run python -m scripts.backfill_finance
#
# OBSERVATIONS_ENABLED: master switch, on unless set falsy (0/false/no/off).
# OBSERVATIONS_FINANCE_HOUR / OBSERVATIONS_FPL_HOUR: local hour (0-23) each collector fires;
#   default 23 and 4. Timezone follows SCHEDULER_TIMEZONE (Europe/Warsaw).
# OBSERVATIONS_TICK_SECONDS: how often the loop checks the clock; default 300 (min 30).
# Watchlist (comma-separated; defaults shown) — FX are vs PLN, equities/metals are Yahoo
# tickers. OBSERVATIONS_SP500_ETF is a EUR cross-listing of the owner's Amundi (ex-Lyxor) Core
# S&P 500 Swap UCITS ETF — the DISTRIBUTING class (ISIN FR0011876061, GPW ticker SP500), which
# Yahoo carries in EUR (default SP5.PA, Euronext Paris; LYPS.DE is the identical Xetra twin) —
# Yahoo has NO GPW PLN listing. From it the collector derives "index:sp500_pln" = ETF(EUR) ×
# EUR/PLN (the real fund's PLN value, ex-dividends like the owner's dist class) and also stores
# the raw EUR price as "etf:amundi_sp500_eur". Must be the DISTRIBUTING class — an accumulating
# line (e.g. A500.MI) drifts ~1.3%/yr high. Requires EUR in OBSERVATIONS_FX; set empty to
# disable the PLN series.
#   OBSERVATIONS_FX=USD,EUR,GBP,CHF
#   OBSERVATIONS_EQUITIES=^GSPC
#   OBSERVATIONS_METALS=GC=F,SI=F
#   OBSERVATIONS_SP500_ETF=SP5.PA
OBSERVATIONS_ENABLED=
OBSERVATIONS_FINANCE_HOUR=
OBSERVATIONS_FPL_HOUR=
OBSERVATIONS_TICK_SECONDS=
OBSERVATIONS_FX=
OBSERVATIONS_EQUITIES=
OBSERVATIONS_METALS=
OBSERVATIONS_SP500_ETF=

# Seconds a Tuya bulb connection may sit unused before it is released
# (good-citizen idle release). Optional; defaults to 120 if unset.
TUYA_IDLE_RELEASE_SECONDS=

# Postgres connection. When set, the long-term memory store uses Postgres instead
# of the on-disk JSON file. For local runs against the docker-compose Postgres:
#   postgresql://jarvis:jarvis@localhost:5432/jarvis
# (inside the compose network the host is "postgres", set by docker-compose.yml)
DATABASE_URL=

# How long (seconds) the coordinator's memory profile (memory.summary()) is cached so it
# isn't a DB read on every turn's hot path. Optional; defaults to 60. Writes through the
# app invalidate it immediately, so a just-saved fact still appears next turn. Set to 0 to
# disable caching (read the store every turn).
MEMORY_SUMMARY_CACHE_TTL_SECONDS=

# MLflow agent tracing (developer observability). When MLFLOW_TRACKING_URI is set,
# the app enables MLflow auto-tracing for the OpenAI Agents SDK and logs every
# coordinator/sub-agent/tool call as a trace. Leave empty to disable tracing.
# Master on/off switch (enabled by default); set to a falsy value (0/false/no/off)
# to hard-disable tracing even when MLFLOW_TRACKING_URI is set.
#   TRACING_ENABLED=
# For a local run against the docker-compose MLflow server (UI at localhost:5001):
#   MLFLOW_TRACKING_URI=http://localhost:5001
# (inside the compose network the host is "mlflow", set by docker-compose.yml)
MLFLOW_TRACKING_URI=
# Experiment name traces are grouped under. Optional; defaults to "jarvis".
MLFLOW_EXPERIMENT=

# Per-subagent on/off switch. Each subagent is enabled by default; set the matching
# var to a falsy value (0/false/no/off) to hide it as a coordinator tool.
#   AGENT_IOT_OPERATOR_ENABLED=
#   AGENT_WEATHER_AGENT_ENABLED=
#   AGENT_FINANCE_AGENT_ENABLED=
#   AGENT_MAPS_AGENT_ENABLED=
#   AGENT_NEWS_AGENT_ENABLED=
#   AGENT_MEMORY_OPERATOR_ENABLED=
#   AGENT_FPL_AGENT_ENABLED=
#   AGENT_SCHEDULER_AGENT_ENABLED=

# --- Scheduler (proactive cron jobs / reminders; see docs/SCHEDULER.md) ---
# The scheduler runs inside the webhook service and fires due jobs on its own,
# messaging you via Messenger (tag HUMAN_AGENT) — or the log for local/REPL runs.
# Master on/off switch (enabled by default); set to a falsy value (0/false/no/off)
# to disable the loop entirely.
SCHEDULER_ENABLED=
# How often (seconds) the loop checks for due jobs. Optional; defaults to 30.
SCHEDULER_TICK_SECONDS=
# Timezone used to interpret cron expressions and 'run_at'. Optional; defaults to
# Europe/Warsaw. Proactive delivery reuses MESSENGER_PAGE_ACCESS_TOKEN below.
SCHEDULER_TIMEZONE=

# --- Interim "still working" progress ping (long turns) ---
# When a live user turn's coordinator runs longer than the threshold below, Jarvis
# pushes ONE templated message ("Chwila, jeszcze nad tym pracuję — sprawdziłem już
# pogodę i trasę…") so you know it isn't hung. No LLM call. Master on/off switch
# (enabled by default); set to a falsy value (0/false/no/off) to disable.
PROGRESS_PING_ENABLED=
# Seconds to wait before firing the interim ping. Optional; defaults to 20.
PROGRESS_PING_AFTER_SECONDS=

# --- Turn time limits (stop a slow/looping turn instead of waiting forever) ---
# Wall-clock cap on one sub-agent run; on timeout the coordinator gets an error telling it
# to carry on without that agent. Optional; default 120. 0 disables.
SUBAGENT_TIMEOUT_SECONDS=
# Wall-clock cap on the coordinator's gather phase; past it the run is stopped and the
# composer replies from the partial results. Optional; default 300. 0 disables.
COORDINATOR_TIMEOUT_SECONDS=
# Per-request timeout and retry count for every LLM provider client. These bound one HTTP
# request only (a streamed response is limited per read). Optional; defaults 60 / 2.
LLM_REQUEST_TIMEOUT_SECONDS=
LLM_MAX_RETRIES=

# --- Forced delegation (coordinator) ---
# Forces the coordinator's first step to call a tool (tool_choice="required"), so it
# delegates to a sub-agent instead of answering from conversation history — weaker/local
# models otherwise invent figures on follow-ups. Pure small talk goes through the
# `no_data_needed` escape tool. Enabled by default; set falsy (0/false/no/off) to disable.
COORDINATOR_FORCE_TOOL=

# --- Conditional watches: predicate sandbox (see docs/SCHEDULER.md, watch-sandbox) ---
# Path to the predicate-sandbox unix socket. When set, watches evaluate their predicate
# in the isolated sandbox (production); when UNSET, the in-process STUB is used (dev/test
# only — NOT a security boundary). The sandbox server + its hardening live privately under
# the git-ignored sandbox/ directory.
WATCH_SANDBOX_SOCKET=

# Authoring pipeline for watch predicates (prepare_watch): the LLM-written Starlark is
# validated in the sandbox and, on failure, repaired by a dedicated "coder" model, bounded
# and fail-closed. The coder model follows the usual AGENT_<NAME>_… convention under the
# name "watch_coder" (falls back to DEFAULT_MODEL):
#   AGENT_WATCH_CODER_MODEL=            provider/model (bare → openai)
#   AGENT_WATCH_CODER_REASONING_EFFORT= off/minimal/low/medium/high
# WATCH_AUTHORING_MAX_REPAIRS: max repair rounds before failing closed (default 3).
AGENT_WATCH_CODER_MODEL=
WATCH_AUTHORING_MAX_REPAIRS=

# --- Facebook Messenger (see docs/MESSENGER.md) ---
# Page Access Token (Messenger API Setup → "2. Generate access tokens").
MESSENGER_PAGE_ACCESS_TOKEN=
# App Secret (App → Settings → Basic) — verifies the X-Hub-Signature-256 header.
MESSENGER_APP_SECRET=
# Your own arbitrary secret for the webhook GET handshake (e.g. `openssl rand -hex 16`).
# Paste the same value into the "Verify token" field in the Meta panel.
MESSENGER_VERIFY_TOKEN=
# Optional: your Page ID (handy for logs/filtering).
MESSENGER_PAGE_ID=
# Optional but recommended for a personal assistant: restrict the bot to your own
# PSID. Read it from the logs after you send the first message, then paste here.
MESSENGER_ALLOWED_SENDER_ID=

DUCK_DNS_TOKEN=